# Copy to .env; scripts/inspect-robots-b601 loads it before every command. Never commit a real key.

# Model credentials for the agent command; the bundled agent.ini uses an openai/* model.
# Read-only commands and the tests need none.
# OPENAI_API_KEY=

# Your robot's profile, if the bundled stock B601-RS on can0 does not fit.
# Relative paths are from the repository root.
# B601_PROFILE=/path/to/my-arm.json

# Stop latch; logs/ is written beside it. Use one per arm.
# B601_STATE_DIR=.hardware-state

# Set these privately on BOTH trusted CLI computers. Never commit real values.
CLOUDFLARE_REALTIME_APP_ID=your-dedicated-sfu-app-id
CLOUDFLARE_REALTIME_APP_SECRET=your-app-secret
B601_REALTIME_KEY=generate-one-shared-random-key-of-at-least-32-bytes

# Optional: set ALL THREE when the network requires a TURN relay.
# B601_REALTIME_TURN_URL=turns:your-turn-host:5349?transport=tcp
# B601_REALTIME_TURN_USERNAME=your-short-lived-turn-username
# B601_REALTIME_TURN_CREDENTIAL=your-short-lived-turn-credential
